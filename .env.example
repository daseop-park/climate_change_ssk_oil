# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# .env 는 git 에 커밋되지 않습니다. 실제 값을 이 파일에 적지 마세요.

# PostgreSQL 연결 문자열.
# 로컬 개발은 Railway 의 공개 프록시 URL 을 씁니다.
#   Railway → Postgres 서비스 → Variables → DATABASE_PUBLIC_URL
#   형태: postgresql://postgres:<비밀번호>@<호스트>.proxy.rlwy.net:<포트>/railway
# Railway 에 배포하면 내부 주소가 자동 주입되므로 배포 환경에는 설정하지 않습니다.
DATABASE_URL=""

# 관리자 JWT 서명 키
JWT_SECRET=""

# 관리자 비밀번호의 scrypt 해시. 원문 비밀번호를 적지 마세요.
#   npm run admin:hash -- "<비밀번호>"
# 형식은 scrypt:<salt>:<hash> 입니다.
# ⚠️ 이 파일의 값에 '$' 가 들어가면 Next 의 .env 변수 확장으로 깨집니다.
ADMIN_PASSWORD_HASH=""

# 전화번호 AES-256-GCM 암호화 키 (32자 이상)
# ⚠️ 이 키가 바뀌면 기존에 저장된 전화번호를 복호화할 수 없습니다.
PHONE_ENCRYPTION_KEY=""

# 전화번호 조회·중복확인용 HMAC-SHA256 시크릿 (32자 이상)
# ⚠️ 이 키가 바뀌면 기존 phoneHash 와 대조가 불가능해집니다.
PHONE_HMAC_SECRET=""

# ── 사이트 접근 게이트 ────────────────────────────────────────────
# 패드 QR 을 통해 들어온 사람만 사이트에 접속할 수 있게 막습니다.
#
# "true" 또는 "1" 일 때만 켜집니다. 그 외의 값(또는 미설정)이면 꺼집니다.
# ⚠️ 켜면 관리자 화면을 포함한 사이트 전체가 잠깁니다. 공모전 심사·포트폴리오 공유처럼
#    외부에서 봐야 하는 기간에는 이 값을 "false" 로 두세요.
SITE_GATE_ENABLED="false"

# 게이트 통과 토큰. QR URL 에 실립니다.  https://<사이트>/?k=<이 값>
# 게이트를 켜 놓고 이 값을 비워두면 아무도 들어올 수 없습니다(의도된 동작).
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SITE_ACCESS_TOKEN=""

# 값 생성 예시
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
